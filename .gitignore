.vs/
.idea/
.gradle/
ExportedObj/
.consulo/

# Unityが自動で作り直すプロジェクトファイル
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
